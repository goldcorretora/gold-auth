# Configurações do Gold Auth Gateway
PORT=8010
ENV=production

# Conexão com o PostgreSQL do Coolify (usa o schema isolado schema_auth)
DATABASE_URL=postgresql://postgres:sua_senha@postgres:5432/postgres

# Segredo criptográfico para assinatura de tokens e sessões
AUTH_SECRET_KEY=gold-corretora-super-secret-key-2026-change-me

# Domínio base do Cookie SSO (com ponto na frente compartilha entre todos os subdomínios)
COOKIE_DOMAIN=.goldcorretora.com.br
COOKIE_SECURE=true

# URL pública do portal de autenticação
PUBLIC_AUTH_URL=https://auth.goldcorretora.com.br

# URL padrão para redirecionar após login quando não há ?rd=
DEFAULT_REDIRECT_URL=https://apps.goldcorretora.com.br

# Retenção dos logs de auditoria em dias (default: 90 dias)
AUDIT_RETENTION_DAYS=90

# Usuário Master inicial (criado automaticamente se o banco estiver vazio)
ADMIN_INITIAL_NAME=Gabriel Gold
ADMIN_INITIAL_EMAIL=admin@goldcorretora.com.br
ADMIN_INITIAL_PASSWORD=Gold@2026

# ==========================================================
# CONFIGURAÇÃO DE E-MAIL INSTITUCIONAL (RESEND / SMTP)
# ==========================================================
# Provedor: Resend (https://resend.com)
SUPPORT_EMAIL=suporte@goldcorretora.com.br
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_sua_api_key_do_resend_aqui
SMTP_FROM_NAME=Gold Corretora de Seguros
SMTP_FROM_EMAIL=notificacoes@goldcorretora.com.br
SMTP_USE_TLS=true
